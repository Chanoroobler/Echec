<?xml version="1.0" encoding="utf-8"?>
<!-- Publication du JEU COMPLET (jumeau de FolderProfile, sans PlaytestBuild) : aucune particularite du playtest,
     commandants debloques par la meta-progression normale. Sortie separee des builds playtest et demo. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>C:\Users\antho\Documents\Asset\FanrasyEchec\BuildFull</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
</Project>
