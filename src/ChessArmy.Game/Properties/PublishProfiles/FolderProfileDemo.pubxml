<?xml version="1.0" encoding="utf-8"?>
<!-- Publication de la version DEMO (jumeau de FolderProfile). DemoBuild=true grave le symbole DEMO :
     IsDemo est forcé dans le code compile, le joueur ne peut pas le desactiver. Sortie separee du depot complet. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>C:\Users\antho\Documents\Asset\FanrasyEchec\BuildDemo</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DemoBuild>true</DemoBuild>
  </PropertyGroup>
</Project>
