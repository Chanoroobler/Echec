{
  // Arbres de commandement. UN arbre par commandant : le commandant le référence dans units.json
  // (champ "tree"). Le joueur dépense des points de commandement (2 par mission réussie + le bonus
  // propre au commandant, ex. "fusionPoints") pendant la phase de PLACEMENT. Tout est propre à la RUN :
  // les nœuds achetés sont sauvegardés avec elle et repartent à zéro à la campagne suivante.
  //
  // Un nœud = une position (branch, level) + une icône + des effets. Deux règles, et deux seulement :
  //   • COÛT   : 2 × level  →  2, 4, 6, 8 points (niveaux 1 à 4).
  //   • PRÉREQUIS : posséder AU MOINS UN nœud du niveau précédent DANS LA MÊME BRANCHE.
  //     Les branches (colonnes) sont donc étanches ; les nœuds de niveau 1 sont toujours achetables.
  //
  // "asset"   : PNG 32×32 dans Assets/CommandTree/<asset>.png, OPTIONNEL — a preciser seulement si l'asset
  //             differe de l'id du noeud (nom aligne sur units.json). Absent → l'id du noeud.
  //             ("icon" reste accepte comme alias historique ; "asset" a priorite si les deux sont donnes.)
  //             Aucun texte dans le nœud : le libellé et la description viennent de strings.csv
  //             (clés "tree.<id>" et "tree.<id>.desc") et ne s'affichent qu'en infobulle.
  // "effects" : un ou plusieurs, de type
  //   { "kind": "commanderStat", "stat": "damage", "amount": 1, "scale": "perDistinctClass" }
  //   { "kind": "commanderTrait", "trait": "Rempart" }        ← trait de Battle.Trait
  //   { "kind": "unitStat",  "stat": "hp", "amount": 2 }      ← toutes les unités HORS commandant
  //   { "kind": "unitTrait", "trait": "Riposte" }
  //   { "kind": "reserveSlots", "amount": 2 }                 ← agrandit la réserve
  //   { "kind": "deploySlots",  "amount": 1 }                 ← agrandit le déploiement
  //   { "kind": "fusionRecruit", "amount": 1 }                ← chaque fusion recrute en plus un tier 1 vu
  //   { "kind": "eliteDeathRecruit", "amount": 1 }            ← chaque unité tier 2+ tombée fait arriver un tier 1 vu en réserve
  //   { "kind": "fusionSizeReduction", "amount": 1 }          ← réduit le nombre de pions requis pour une fusion tier 1→2 (min 2)
  //
  // "stat"  : hp | damage | moveRange | attackRange
  // "scale" : flat (défaut) | perDistinctClass → bonus × classes distinctes du roster hors commandant (réserve + jeu),
  //           | perDistinctPair  → la même chose ÷ 2 (par paire de classes distinctes),
  //           figés au moment du placement. Récompensent la variété de l'armée.
  "trees": [
    {
      "id": "commandant",
      "nodes": [
        // ── Branche 0 : le COMMANDANT lui-même ──────────────────────────────────────────────────
        { "id": "cmd_Duelliste", "branch": 0, "level": 1, "effects": [ { "kind": "commanderTrait", "trait": "Duelliste" } ] },
        { "id": "cmd_puissance", "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "damage", "amount": 1, "scale": "perDistinctClass" } ] },        
        { "id": "cmd_mouvement", "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "moveRange",   "amount": 1 } ] },
        { "id": "cmd_vie",       "branch": 0, "level": 3, "effects": [ { "kind": "commanderStat", "stat": "hp",     "amount": 2, "scale": "perDistinctClass" } ] },
        { "id": "cmd_Orage", "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Orage" } ] },
        { "id": "cmd_portee",    "branch": 0, "level": 4, "effects": [ { "kind": "commanderStat", "stat": "attackRange", "amount": 1 } ] },

        // ── Branche 1 : les TROUPES (tout le roster hors commandant) ────────────────────────────
        { "id": "troupe_vie",       "branch": 1, "level": 1, "effects": [ { "kind": "unitStat", "stat": "hp", "amount": 2 } ] },
        { "id": "troupe_releve",    "branch": 1, "level": 2, "effects": [ { "kind": "eliteDeathRecruit", "amount": 1 } ] },        
        { "id": "troupe_vie_paire", "branch": 1, "level": 2, "effects": [ { "kind": "unitStat", "stat": "hp",     "amount": 1, "scale": "perDistinctClass" } ] },
        { "id": "troupe_puissance", "branch": 1, "level": 3, "effects": [ { "kind": "unitStat", "stat": "damage", "amount": 1, "scale": "perDistinctClass" } ] },
        { "id": "troupe_mouvement", "branch": 1, "level": 4, "effects": [ { "kind": "unitStat", "stat": "moveRange", "amount": 1 } ] },

        // ── Branche 2 : la LOGISTIQUE (déploiement + réserve) ───────────────────────────────────
        { "id": "logi_deploiement_1", "branch": 2, "level": 1, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "logi_reserve_1",     "branch": 2, "level": 2, "effects": [ { "kind": "reserveSlots", "amount": 2 } ] },
        { "id": "troupe_fusion", "branch": 2, "level": 2, "effects": [ { "kind": "fusionRecruit",  "amount": 1 } ] },
        { "id": "logi_deploiement_2", "branch": 2, "level": 3, "effects": [ { "kind": "deploySlots", "amount": 2 } ] },
        // logi_deploiement_3 : REPURPOSÉ en « Grande Armée » (+4 réserve) — cf. strings.csv tree.logi_deploiement_3.
        { "id": "logi_deploiement_3", "branch": 2, "level": 3, "effects": [ { "kind": "reserveSlots", "amount": 4 } ] },
        // amalgame : une fusion tier 1→2 ne demande plus que 2 pions (au lieu de 3) ; tier 2→3 reste à 3. Icône : Assets/CommandTree/amalgame.png.
        { "id": "amalgame",           "branch": 2, "level": 4, "effects": [ { "kind": "fusionSizeReduction", "amount": 1 } ] }
      ]
    },

    // ── Arbre du commandant LANCIER (tree "commandantLancier") ─────────────────────────────────────────
    // Thème : le domaine de la TOUR (Lanciers) et les AURAS. Trois nouveaux effets par rapport à l'arbre de
    // base : "domaine" restreint un bonus d'unité au domaine ciblé (ici Tour) ; l'échelle "perDomaineUnit"
    // multiplie le bonus par le nombre d'unités de ce domaine (réserve + jeu) ; une recrue (fusion/relève)
    // avec "domaine" recrute la CLASSE DE BASE de ce domaine (un Lancier) au lieu d'un tier 1 vu au hasard.
    {
      "id": "commandantLancier",
      "nodes": [
        // ── Branche 0 : le COMMANDANT (Lancier) ─────────────────────────────────────────────────
        { "id": "lan_cmd_rempart",           "branch": 0, "level": 1, "effects": [ { "kind": "commanderTrait", "trait": "Rempart" } ] },
        { "id": "lan_cmd_portee",            "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "attackRange", "amount": 1 } ] },
        { "id": "lan_cmd_pv_tour",           "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "hp", "amount": 3, "scale": "perDomaineUnit", "domaine": "Tour" } ] },
        { "id": "lan_cmd_aura_rempart",      "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Aura de rempart" } ] },
        { "id": "lan_cmd_riposte",           "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Riposte" } ] },
        // Repurposé « Séisme » : à la fin du tour ennemi, le commandant frappe les ennemis adjacents pour sa puissance.
        { "id": "lan_cmd_seisme", "branch": 0, "level": 4, "effects": [ { "kind": "commanderTrait", "trait": "Séisme" } ] },

        // ── Branche 1 : les UNITÉS du domaine TOUR (Lanciers) ───────────────────────────────────
        { "id": "lan_tour_pv",             "branch": 1, "level": 1, "effects": [ { "kind": "unitStat", "stat": "hp", "amount": 4, "domaine": "Tour" } ] },
        // Repurposé « Rempart renforcé » : la réduction du trait Rempart passe de 4 à 6 (bonus +2).
        { "id": "lan_tour_pv_tour",        "branch": 1, "level": 3, "effects": [ { "kind": "rempartBonus", "amount": 2 } ] },
        { "id": "lan_tour_aura_puissance", "branch": 1, "level": 2, "effects": [ { "kind": "unitTrait", "trait": "Aura de puissance", "domaine": "Tour" } ] },
        { "id": "lan_tour_releve",         "branch": 1, "level": 2, "effects": [ { "kind": "eliteDeathRecruit", "amount": 1, "domaine": "Tour" } ] },
        // Repurposé « Formation renforcée » : la puissance par allié adjacent du trait Formation passe de 2 à 3 (bonus +1, joueur seulement).
        { "id": "lan_formation_renforce",  "branch": 1, "level": 3, "effects": [ { "kind": "formationBonus", "amount": 1 } ] },
        // « Marche des lanciers » descend ici (déplacement +1 aux unités Tour), à la place de l'allonge.
        { "id": "lan_tour_pm",             "branch": 1, "level": 4, "effects": [ { "kind": "unitStat", "stat": "moveRange", "amount": 1, "domaine": "Tour" } ] },

        // ── Branche 2 : la LOGISTIQUE (déploiement + réserve + fusion) ───────────────────────────
        { "id": "lan_logi_deploy_1", "branch": 2, "level": 1, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "lan_logi_fusion",   "branch": 2, "level": 2, "effects": [ { "kind": "fusionRecruit", "amount": 1, "domaine": "Tour" } ] },
        //{ "id": "lan_logi_deploy_2", "branch": 2, "level": 2, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "lan_logi_reserve_1","branch": 2, "level": 2, "effects": [ { "kind": "reserveSlots", "amount": 2 } ] },
        { "id": "lan_logi_deploy_3", "branch": 2, "level": 3, "effects": [ { "kind": "deploySlots",  "amount": 2 } ] },
        // Repurposé « Amalgame » (Tour) : une fusion tier 1→2 d'une classe du domaine de la TOUR ne demande que 2 pions.
        { "id": "lan_logi_reserve_2","branch": 2, "level": 4, "effects": [ { "kind": "fusionSizeReduction", "amount": 1, "domaine": "Tour" } ] }
      ]
    },

    // ── Arbre du commandant FOU (tree "commandantFou") ───────────────────────────────────────────────
    // Thème : le domaine du FOU (Mages) et le SOUTIEN. Deux nouveaux traits : "Repositionnement stratégique"
    // (un pas d'une case a gauche/droite en plus du motif natif) et "Lien de puissance" (+2 puissance par allié
    // dans la portée de déplacement). L'échelle "perDomaineUnit" + "domaine":"Fou" met certains bonus a l'échelle
    // du nombre de Mages ; une recrue (fusion/relève) "domaine":"Fou" recrute un Mage (classe de base du Fou).
    {
      "id": "commandantFou",
      "nodes": [
        // ── Branche 0 : le COMMANDANT (Mage) ────────────────────────────────────────────────────
        { "id": "fou_cmd_reposition", "branch": 0, "level": 1, "effects": [ { "kind": "commanderTrait", "trait": "Repositionnement stratégique" } ] },
        { "id": "fou_cmd_portee", "asset": "lan_cmd_portee", "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "attackRange", "amount": 1 } ] },
        { "id": "fou_cmd_puissance_fou", "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "damage", "amount": 1, "scale": "perDomaineUnit", "domaine": "Fou" } ] },
        { "id": "fou_cmd_drain",      "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Drain de vie" } ] },
        { "id": "fou_cmd_pv_fou",     "branch": 0, "level": 3, "effects": [ { "kind": "commanderStat", "stat": "hp", "amount": 3, "scale": "perDomaineUnit", "domaine": "Fou" } ] },
        { "id": "fou_cmd_tempete",    "branch": 0, "level": 4, "effects": [ { "kind": "commanderTrait", "trait": "Tempête" } ] },

        // ── Branche 1 : les UNITÉS du domaine du FOU (Mages) ─────────────────────────────────────
        { "id": "fou_unit_reposition", "branch": 1, "level": 1, "effects": [ { "kind": "unitTrait", "trait": "Repositionnement stratégique", "domaine": "Fou" } ] },
        { "id": "fou_unit_aura_puissance", "branch": 1, "level": 2, "effects": [ { "kind": "unitTrait", "trait": "Aura de puissance", "domaine": "Fou" } ] },
        { "id": "fou_unit_releve",     "branch": 1, "level": 2, "effects": [ { "kind": "eliteDeathRecruit", "amount": 1, "domaine": "Fou" } ] },
        { "id": "fou_unit_lien",       "branch": 1, "level": 3, "effects": [ { "kind": "unitTrait", "trait": "Lien de puissance", "domaine": "Fou" } ] },
        { "id": "fou_unit_statique",   "branch": 1, "level": 3, "effects": [ { "kind": "unitTrait", "trait": "Statique", "domaine": "Fou" } ] },
        { "id": "fou_unit_portee",     "branch": 1, "level": 4, "effects": [ { "kind": "unitStat", "stat": "attackRange", "amount": 1, "domaine": "Fou" } ] },

        // ── Branche 2 : la LOGISTIQUE (déploiement + réserve + fusion) ───────────────────────────
        { "id": "fou_logi_deploy_1", "asset": "logi_deploiement_1",  "branch": 2, "level": 1, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "fou_logi_fusion",    "branch": 2, "level": 2, "effects": [ { "kind": "fusionRecruit", "amount": 1, "domaine": "Fou" } ] },
        { "id": "fou_logi_reserve_1", "asset": "lan_logi_reserve_1", "branch": 2, "level": 2, "effects": [ { "kind": "reserveSlots", "amount": 2 } ] },
        { "id": "fou_logi_deploy_2", "asset": "logi_deploiement_1",  "branch": 2, "level": 3, "effects": [ { "kind": "deploySlots",  "amount": 2 } ] },
        { "id": "fou_logi_reserve_2", "asset": "lan_logi_reserve_1", "branch": 2, "level": 3, "effects": [ { "kind": "reserveSlots", "amount": 4 } ] },
        { "id": "fou_logi_amalgame",  "branch": 2, "level": 4, "effects": [ { "kind": "fusionSizeReduction", "amount": 1, "domaine": "Fou" } ] }
      ]
    },

    // ── Arbre du commandant CAVALIER (tree "commandantCavalier") ─────────────────────────────────────
    // Thème : le domaine du CAVALIER (saut en L) et la CHARGE. Deux nouveaux traits : « Loup solitaire »
    // (isolé = +3 puissance et -2 dégâts subis) et « Épines » (renvoie la moitié des dégâts subis). Deux
    // nouveaux effets : "impactBonus" (les dégâts d'« Impact » passent de 5 à 8) et "extraTurnOnKill" (une
    // unité du domaine qui TUE par son attaque rend la main au joueur — une seule fois entre deux tours
    // ennemis). L'échelle "perDeployedDomaineUnit" compte les pions du domaine réellement POSÉS sur le
    // plateau (la réserve ne compte pas), figée au lancement du combat.
    {
      "id": "commandantCavalier",
      "nodes": [
        // ── Branche 0 : le COMMANDANT (Cavalier) ────────────────────────────────────────────────
        { "id": "cav_cmd_loup",       "branch": 0, "level": 1, "effects": [ { "kind": "commanderTrait", "trait": "Loup solitaire" } ] },
        { "id": "cav_cmd_pv_cavalier","branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "hp", "amount": 2, "scale": "perDomaineUnit", "domaine": "Cavalier" } ] },
        { "id": "cav_cmd_impact",     "branch": 0, "level": 2, "effects": [ { "kind": "commanderTrait", "trait": "Impact" } ] },
        { "id": "cav_cmd_puissance_cavalier", "branch": 0, "level": 3, "effects": [ { "kind": "commanderStat", "stat": "damage", "amount": 1, "scale": "perDomaineUnit", "domaine": "Cavalier" } ] },
        { "id": "cav_cmd_vol",        "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Vol" } ] },
        { "id": "cav_cmd_epines",     "branch": 0, "level": 4, "effects": [ { "kind": "commanderTrait", "trait": "Épines" } ] },

        // ── Branche 1 : les UNITÉS du domaine CAVALIER ───────────────────────────────────────────
        { "id": "cav_unit_pv",        "branch": 1, "level": 1, "effects": [ { "kind": "unitStat", "stat": "hp", "amount": 5, "domaine": "Cavalier" } ] },
        { "id": "cav_unit_impact",    "branch": 1, "level": 2, "effects": [ { "kind": "unitTrait", "trait": "Impact", "domaine": "Cavalier" } ] },
        { "id": "cav_unit_releve",    "branch": 1, "level": 2, "effects": [ { "kind": "eliteDeathRecruit", "amount": 1, "domaine": "Cavalier" } ] },
        // « Impact renforcé » : les dégâts du trait Impact passent de 5 à 8 (bonus +3, joueur seulement).
        { "id": "cav_unit_impact_renforce", "branch": 1, "level": 3, "effects": [ { "kind": "impactBonus", "amount": 3 } ] },
        { "id": "cav_unit_puissance_cavalier", "branch": 1, "level": 3, "effects": [ { "kind": "unitStat", "stat": "damage", "amount": 1, "scale": "perDeployedDomaineUnit", "domaine": "Cavalier" } ] },
        // « Charge » : un kill PAR L'ATTAQUE d'une unité du domaine rend la main au joueur (1 fois par tour).
        { "id": "cav_unit_charge",    "branch": 1, "level": 4, "effects": [ { "kind": "extraTurnOnKill", "domaine": "Cavalier" } ] },

        // ── Branche 2 : la LOGISTIQUE (déploiement + réserve + fusion) ───────────────────────────
        { "id": "cav_logi_deploy_1",  "asset": "logi_deploiement_1",  "branch": 2, "level": 1, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "cav_logi_fusion",    "branch": 2, "level": 2, "effects": [ { "kind": "fusionRecruit", "amount": 1, "domaine": "Cavalier" } ] },
        { "id": "cav_logi_reserve_1", "asset": "lan_logi_reserve_1",  "branch": 2, "level": 2, "effects": [ { "kind": "reserveSlots", "amount": 2 } ] },
        { "id": "cav_logi_deploy_2",  "asset": "logi_deploiement_1",  "branch": 2, "level": 3, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "cav_logi_reserve_2", "asset": "lan_logi_reserve_1",  "branch": 2, "level": 3, "effects": [ { "kind": "reserveSlots", "amount": 4 } ] },
        { "id": "cav_logi_amalgame",  "branch": 2, "level": 4, "effects": [ { "kind": "fusionSizeReduction", "amount": 1, "domaine": "Cavalier" } ] }
      ]
    },

    // ── Arbre du commandant MARCHAND (tree "commandantMarchand") ─────────────────────────────────────
    // Thème : l'ÉQUIPEMENT. C'est le SEUL commandant qui peut s'équiper (les autres n'ont aucun slot), et le
    // seul dont les pions peuvent porter DEUX objets. Six effets propres à cet arbre :
    //   "commanderEquipSlots" : donne N slot(s) d'équipement au COMMANDANT (0 partout ailleurs) ;
    //   "unitEquipSlots"      : donne N slot(s) EN PLUS à chaque pion (base 1) ;
    //   "chestExtraItem"      : chaque coffre donne N objet(s) de plus (tirages COMPLETS et indépendants) ;
    //   "chestRarityBonus"    : + N POINTS de % sur les chances RARE et LÉGENDAIRE d'un coffre ;
    //   "rerollEquipment"     : chaque relance d'unité rapporte N équipement (tiré comme un coffre) ;
    //   "recruitExtraUnit"    : la tuile RECRUE du terrain donne N pion(s) de plus (tirage indépendant) ;
    //   "recycleRecruit"      : RECYCLER un equipement fait venir N pion(s) tier 1 : celui dont on a deja le
    //                           plus d'exemplaires (cf. Run.MostOwnedTier1), donc celui qui rapproche d'une fusion.
    // Et deux échelles :
    //   "perEquippedItem"    = × le nombre d'équipements POSSEDES (posés sur une unité, commandant compris,
    //                          PLUS ceux qui dorment en inventaire) — c'est le STOCK qui fait monter ces bonus,
    //                          pas le fait de l'équiper ; ils retombent quand un objet est réellement perdu
    //                          (porteur mort, objet recyclé) ;
    //   "perOwnEquippedItem" = × le nombre d'équipements que le porteur du bonus a LUI-MEME sur le dos. Seul
    //                          le Marchand a des emplacements, donc seul lui en profite (cf. mar_cmd_slot_1). Le trait « Renaissance ultime » (nœud final) ramène le
    // commandant à PV pleins une fois par PARTIE (cf. Run.UltimateReviveUsed, persisté avec la run).
    // ICÔNES À DESSINER : Assets/CommandTree/<id>.png (32×32) pour tous les nœuds sans "asset".
    {
      "id": "commandantMarchand",
      "nodes": [
        // ── Branche 0 : le COMMANDANT s'équipe ───────────────────────────────────────────────────
        // Le +2 pv / +2 puissance PAR OBJET QU'IL PORTE est porte par CE nœud (le premier emplacement) : il est
        // la porte d'entree obligatoire de la branche, donc le bonus vaut des que le commandant peut s'equiper.
        // Il est RAPPELE entre parentheses sur "mar_cmd_slot_2" (BESACE), ou les 2/2 sont ecrits en dur dans
        // strings.csv : changer les montants ici oblige a retoucher CETTE description-la aussi.
        { "id": "mar_cmd_slot_1",         "branch": 0, "level": 1, "effects": [
            { "kind": "commanderEquipSlots", "amount": 1 },
            { "kind": "commanderStat", "stat": "hp",     "amount": 2, "scale": "perOwnEquippedItem" },
            { "kind": "commanderStat", "stat": "damage", "amount": 2, "scale": "perOwnEquippedItem" } ] },
        { "id": "mar_cmd_pv_stock",       "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "hp", "amount": 2, "scale": "perEquippedItem" } ] },
        { "id": "mar_cmd_esquive", "asset": "cmd_Esquive", "branch": 0, "level": 2, "effects": [ { "kind": "commanderTrait", "trait": "Esquive" } ] },
        { "id": "mar_cmd_slot_2",         "branch": 0, "level": 3, "effects": [ { "kind": "commanderEquipSlots", "amount": 1 } ] },
        { "id": "mar_cmd_puissance_stock","branch": 0, "level": 3, "effects": [ { "kind": "commanderStat", "stat": "damage", "amount": 1, "scale": "perEquippedItem" } ] },
        { "id": "mar_cmd_renaissance",    "branch": 0, "level": 4, "effects": [ { "kind": "commanderTrait", "trait": "Renaissance ultime" } ] },

        // ── Branche 1 : le BUTIN (coffres, raretés, relances, slots des pions) ───────────────────
        { "id": "mar_loot_relance",       "branch": 1, "level": 1, "effects": [ { "kind": "rerollEquipment", "amount": 1 } ] },
        { "id": "mar_loot_rarete_1", "asset": "mar_loot_rarete_1",  "branch": 1, "level": 2, "effects": [ { "kind": "chestRarityBonus", "amount": 7 } ] },
        { "id": "mar_loot_ferraille",                              "branch": 1, "level": 2, "effects": [ { "kind": "recycleRecruit", "amount": 1 } ] },
        { "id": "mar_loot_rarete_2", "asset": "mar_loot_rarete_1", "branch": 1, "level": 3, "effects": [ { "kind": "chestRarityBonus", "amount": 7 } ] },
        { "id": "mar_unit_slot_2",        "branch": 1, "level": 3, "effects": [ { "kind": "unitEquipSlots", "amount": 1 } ] },
        { "id": "mar_loot_coffre_double", "branch": 1, "level": 4, "effects": [ { "kind": "chestExtraItem", "amount": 1 } ] },

        // ── Branche 2 : la LOGISTIQUE (déploiement + réserve + recrues) ──────────────────────────
        { "id": "mar_logi_deploy_1",  "asset": "logi_deploiement_1", "branch": 2, "level": 1, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "mar_logi_deploy_2",  "asset": "logi_deploiement_2", "branch": 2, "level": 2, "effects": [ { "kind": "deploySlots",  "amount": 2 } ] },
        { "id": "mar_logi_reserve_1", "asset": "lan_logi_reserve_1", "branch": 2, "level": 2, "effects": [ { "kind": "reserveSlots", "amount": 2 } ] },
        { "id": "mar_logi_recrue_double",                            "branch": 2, "level": 3, "effects": [ { "kind": "recruitExtraUnit", "amount": 1 } ] },
        { "id": "mar_logi_reserve_2", "asset": "lan_logi_reserve_1", "branch": 2, "level": 3, "effects": [ { "kind": "reserveSlots", "amount": 4 } ] },
        { "id": "mar_logi_deploy_3",  "asset": "logi_deploiement_2", "branch": 2, "level": 4, "effects": [ { "kind": "deploySlots",  "amount": 4 } ] }
      ]
    },

    // ── Arbre du commandant DUO (tree "commandantDuo") ───────────────────────────────────────────────
    // Deux meneurs, deux branches : l'ARTISAN MEURTRIER a gauche (branche 0, autour de la TROUSSE DE SOIN),
    // BASILE a droite (branche 2, autour de la SACOCHE) et, au centre (branche 1), ce qui les LIE.
    // Effets propres a ce commandant (cf. CommandEffectKind) :
    //   { "kind": "companionStat", "stat": "attackRange", "amount": 1 }  ← vise BASILE seul
    //   { "kind": "companionTrait", "trait": "Recule" }                  ← idem (commanderStat/Trait = l'artisan seul)
    //   { "kind": "healKitTiles" }    ← les tuiles recrue des maps deviennent des TROUSSES DE SOIN
    //   { "kind": "satchelChests" }   ← les coffres des maps deviennent des SACOCHES
    //   { "kind": "satchelForCompanion" } ← l'ARTISAN peut fouiller une sacoche : l'objet part chez BASILE
    //   { "kind": "healKitOnKill" }   ← chaque mise a mort de l'artisan pose une trousse sur une case libre
    //   { "kind": "healKitMaxHp",  "amount": 1 }  ← +1 PV max DEFINITIF par trousse utilisee (les deux meneurs)
    //   { "kind": "satchelMaxHp",  "amount": 1 }  ← +1 PV max DEFINITIF par objet pris dans une sacoche
    //   { "kind": "roque" }           ← les deux meneurs echangent leurs places en se marchant dessus
    //   { "kind": "roquePower", "amount": 5 } ← chaque roque met +5 puissance en reserve sur l'ARTISAN
    //                                           (depensee par sa prochaine attaque ; ne se cumule pas)
    //   { "kind": "crossKillPower", "amount": 1 } ← +1 puissance a l'ARTISAN par tranche de 3 kills de BASILE
    //   { "kind": "soloSurvivor" }    ← la chute d'UN meneur ne perd plus la run : le survivant continue
    //                                   SEUL et herite de la moitie de la puissance et des PV max du tombe
    // SANS le nœud "duo_trousse_terrain" (resp. "duo_sacoche_terrain"), les tuiles recrue (resp. les coffres)
    // sont simplement RETIREES des maps : c'est le premier achat qui ouvre l'economie de ce commandant.
    // ICÔNES À DESSINER : Assets/CommandTree/<id>.png (32×32) pour tous les nœuds sans "asset".
    {
      "id": "commandantDuo",
      "nodes": [
        // ── Branche 0 : L'ARTISAN MEURTRIER et les TROUSSES DE SOIN ──────────────────────────────        
        { "id": "duo_roque",            "branch": 0, "level": 1, "effects": [ { "kind": "roque" } ] },                        
        { "id": "duo_trousse_kill",     "branch": 0, "level": 2, "effects": [ { "kind": "healKitOnKill" } ] },
        // Suite naturelle de "duo_roque" juste au-dessus : sans lui il n'y a jamais de roque et l'effet dort.
        { "id": "duo_roque_puissance",  "branch": 0, "level": 2, "effects": [ { "kind": "roquePower", "amount": 5 } ] },
        { "id": "duo_kills_partages",   "branch": 0, "level": 3, "effects": [ { "kind": "crossKillPower", "amount": 1 } ] },
        { "id": "duo_art_riposte", "asset": "lan_cmd_riposte", "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Riposte" } ] },        
        { "id": "duo_art_chaine",       "branch": 0, "level": 4, "effects": [ { "kind": "commanderTrait", "trait": "Réaction en chaîne" } ] },

        // ── Branche 1 : ce qui LIE les deux meneurs ──────────────────────────────────────────────
        { "id": "duo_trousse_terrain",  "branch": 1, "level": 1, "effects": [ { "kind": "healKitTiles" } ] },
        { "id": "duo_lien_amitie",      "branch": 1, "level": 2, "effects": [
            { "kind": "commanderTrait", "trait": "Lien d'amitié" },
            { "kind": "companionTrait", "trait": "Lien d'amitié" } ] },
        { "id": "duo_trousse_pv",       "branch": 1, "level": 2, "effects": [ { "kind": "healKitMaxHp", "amount": 2 } ] },
        // Branche du LIEN : le pas gagne se prend a DEUX (comme "duo_lien_amitie" plus haut).
        { "id": "duo_art_mouvement", "asset": "cmd_mouvement", "branch": 1, "level": 3, "effects": [
            { "kind": "commanderStat", "stat": "moveRange", "amount": 1 },
            { "kind": "companionStat", "stat": "moveRange", "amount": 1 } ] },
        // Bout de la branche du LIEN : le duo survit a la perte de l'un des deux.
        { "id": "duo_continue_sans_moi", "branch": 1, "level": 4, "effects": [ { "kind": "soloSurvivor" } ] },

        // ── Branche 2 : BASILE et les SACOCHES ───────────────────────────────────────────────────
        { "id": "duo_sacoche_terrain",  "branch": 2, "level": 1, "effects": [ { "kind": "satchelChests" } ] },        
        { "id": "duo_sacoche_artisan",  "branch": 2, "level": 2, "effects": [ { "kind": "satchelForCompanion" } ] },
        { "id": "duo_sacoche_pv",       "branch": 2, "level": 2, "effects": [ { "kind": "satchelMaxHp", "amount": 1 } ] },
        { "id": "duo_sacoche_aimant", "asset": "duo_sacoche_aimant", "branch": 2, "level": 3, "effects": [ { "kind": "satchelPull" } ] },
        { "id": "duo_bas_portee", "asset": "lan_cmd_portee", "branch": 2, "level": 3, "effects": [ { "kind": "companionStat", "stat": "attackRange", "amount": 1 } ] },
        { "id": "duo_bas_ligne",        "branch": 2, "level": 4, "effects": [ { "kind": "companionTrait", "trait": "Tir en ligne" } ] }
      ]
    },

    // ── Arbre du commandant BRUTE (tree "commandantBrute") ─────────────────────────────────────────────
    // Theme : la PERTE comme ressource. Sa source de points est deja « sur perte » (cf. units.json), et ses
    // trois branches en tirent parti differemment.
    //   • Branche 0 — le SACRIFICE : elle grossit et frappe plus fort a chaque pion tombe (allyDeathMaxHp /
    //     allyDeathPower, qui lisent le compteur Run.AllyDeaths), peut frapper les siens pour se soigner
    //     (« Sacrifice »), pousser un allie devant un coup (« Bouclier humain ») et finir par les LANCER sur
    //     l'ennemi (« Chair a canon »).
    //   • Branche 1 — le PAYSAN : un pion UNIQUE et exclusif (cf. la section « exclusives » d'units.json),
    //     recrute par le noeud de niveau 1, qui monte tout seul par son trait « Survivant » et evolue par deux
    //     noeuds a CHOIX. Ces noeuds ne declarent aucune option : elles viennent de l'arbre de classes du pion
    //     au moment de l'achat (paysan -> archer|epeiste, puis -> duelliste|rempart de la branche retenue).
    //     « Revolte » lui donne le commandement : la Brute reste sur le plateau en pion ORDINAIRE (mortelle,
    //     mais elle garde tous les bonus de la branche 0) et toute la pietaille tier 1 est relevee.
    //   • Branche 2 — la LOGISTIQUE : poser plus de pions, en garder plus, en recruter davantage.
    //     Au bout, la RELEVE : chaque unite de tier 2 ou 3 tombee fait arriver 2 unites de tier 1 aleatoires (deja decouvertes).
    // ICONES : aucun noeud ne declare d'"asset" — chacun attend son propre PNG 32x32
    // Assets/CommandTree/<id du noeud>.png. Tant qu'il manque, le jeu affiche le placeholder colore par
    // branche : on VOIT ce qui reste a dessiner, au lieu d'emprunter l'icone d'un autre arbre qui mentirait
    // sur l'effet du noeud.
    {
      "id": "commandantBrute",
      "nodes": [
        // ── Branche 0 : le SACRIFICE ────────────────────────────────────────────────────────────
        { "id": "brute_pv_pertes", "branch": 0, "level": 1, "effects": [ { "kind": "allyDeathMaxHp", "amount": 2 } ] },
        { "id": "brute_rage", "branch": 0, "level": 2, "effects": [ { "kind": "commanderTrait", "trait": "Rage" } ] },
        { "id": "brute_sacrifice", "branch": 0, "level": 2, "effects": [ { "kind": "commanderTrait", "trait": "Sacrifice" } ] },
        { "id": "brute_puissance_pertes", "branch": 0, "level": 3, "effects": [ { "kind": "allyDeathPower", "amount": 1 } ] },
        { "id": "brute_bouclier", "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Bouclier humain" } ] },
        { "id": "brute_chair_a_canon", "branch": 0, "level": 4, "effects": [ { "kind": "commanderTrait", "trait": "Chair à canon" } ] },

        // ── Branche 1 : le PAYSAN ───────────────────────────────────────────────────────────────
        { "id": "brute_paysan", "branch": 1, "level": 1, "effects": [ { "kind": "recruitExclusive", "asset": "paysan" } ] },
        { "id": "brute_vengeance", "branch": 1, "level": 2, "effects": [ { "kind": "unitTrait", "trait": "Vengeance" } ] },
        // Noeud a CHOIX : archerie (+1 portee) ou epeiste (+1 deplacement). Les deux options sont les
        // evolutions de la classe courante du Paysan — rien a declarer ici.
        { "id": "brute_armement", "branch": 1, "level": 2, "effects": [ { "kind": "evolveExclusive" } ] },
        { "id": "brute_formation", "branch": 1, "level": 3, "effects": [ { "kind": "exclusiveTrait", "trait": "Formation" } ] },
        // Second noeud a CHOIX : duelliste ou rempart, sur la branche d'armement deja retenue.
        { "id": "brute_protection", "branch": 1, "level": 3, "effects": [ { "kind": "evolveExclusive" } ] },
        // Le +1 déplacement va à tout le tier 1 SAUF le Cavalier (déjà rapide) : les effets ne savent que
        // CIBLER un domaine, pas en exclure un, d'où un effet par domaine restant. La description n'annonce
        // que « {3} déplacement » : l'exception est volontairement tue.
        { "id": "brute_revolte", "branch": 1, "level": 4, "effects": [
            { "kind": "revolte", "asset": "paysan" },
            { "kind": "unitStat", "stat": "hp", "amount": 12, "tier": 1 },
            { "kind": "unitStat", "stat": "damage", "amount": 8, "tier": 1 },
            { "kind": "unitStat", "stat": "moveRange", "amount": 1, "tier": 1, "domaine": "Dame" },
            { "kind": "unitStat", "stat": "moveRange", "amount": 1, "tier": 1, "domaine": "Tour" },
            { "kind": "unitStat", "stat": "moveRange", "amount": 1, "tier": 1, "domaine": "Fou" } ] },

        // ── Branche 2 : la LOGISTIQUE ───────────────────────────────────────────────────────────
        { "id": "brute_deploiement_1",  "asset": "logi_deploiement_1", "branch": 2, "level": 1, "effects": [ { "kind": "deploySlots", "amount": 1 } ] },
        { "id": "brute_reserve", "asset": "lan_logi_reserve_1", "branch": 2, "level": 2, "effects": [ { "kind": "reserveSlots", "amount": 2 } ] },
        { "id": "brute_fusion_soldat", "branch": 2, "level": 2, "effects": [ { "kind": "fusionRecruit", "amount": 1, "domaine": "Dame" } ] },
        { "id": "brute_deploiement_2",  "asset": "logi_deploiement_1", "branch": 2, "level": 3, "effects": [ { "kind": "deploySlots", "amount": 2 } ] },
        { "id": "brute_masse", "branch": 2, "level": 3, "effects": [ { "kind": "reserveThresholdRecruit", "amount": 3, "domaine": "Dame" } ] },
        // Fin de la LOGISTIQUE : la relève du commandant de base, en DOUBLE — une élite perdue se remplace par du
        // nombre (2 tier 1 déjà découverts au hasard), ce qui nourrit aussi la source de points « sur perte ».
        { "id": "brute_releve", "branch": 2, "level": 4, "effects": [ { "kind": "eliteDeathRecruit", "amount": 2 } ] }
      ]
    }
  ]
}
