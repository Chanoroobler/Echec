{
  // Arbres de commandement. UN arbre par commandant : le commandant le référence dans units.json
  // (champ "tree"). Le joueur dépense des points de commandement (2 par mission réussie + le bonus
  // propre au commandant, ex. "fusionPoints") pendant la phase de PLACEMENT. Tout est propre à la RUN :
  // les nœuds achetés sont sauvegardés avec elle et repartent à zéro à la campagne suivante.
  //
  // Un nœud = une position (branch, level) + une icône + des effets. Deux règles, et deux seulement :
  //   • COÛT   : 2 × level  →  2, 4, 6, 8 points (niveaux 1 à 4).
  //   • PRÉREQUIS : posséder AU MOINS UN nœud du niveau précédent DANS LA MÊME BRANCHE.
  //     Les branches (colonnes) sont donc étanches ; les nœuds de niveau 1 sont toujours achetables.
  //
  // "icon"    : PNG 32×32 dans Assets/CommandTree/<icon>.png (absent → l'id du nœud).
  //             Aucun texte dans le nœud : le libellé et la description viennent de strings.csv
  //             (clés "tree.<id>" et "tree.<id>.desc") et ne s'affichent qu'en infobulle.
  // "effects" : un ou plusieurs, de type
  //   { "kind": "commanderStat", "stat": "damage", "amount": 1, "scale": "perDistinctPair" }
  //   { "kind": "commanderTrait", "trait": "Rempart" }        ← trait de Battle.Trait
  //   { "kind": "unitStat",  "stat": "hp", "amount": 2 }      ← toutes les unités HORS commandant
  //   { "kind": "unitTrait", "trait": "Riposte" }
  //   { "kind": "reserveSlots", "amount": 2 }                 ← agrandit la réserve
  //   { "kind": "deploySlots",  "amount": 1 }                 ← agrandit le déploiement
  //   { "kind": "fusionRecruit", "amount": 1 }                ← chaque fusion recrute en plus un tier 1 vu
  //   { "kind": "eliteDeathRecruit", "amount": 1 }            ← chaque unité tier 2+ tombée fait arriver un tier 1 vu en réserve
  //   { "kind": "fusionSizeReduction", "amount": 1 }          ← réduit le nombre de pions requis pour une fusion (min 2)
  //
  // "stat"  : hp | damage | moveRange | attackRange
  // "scale" : flat (défaut) | perDistinctPair  → bonus × (classes distinctes du roster hors commandant ÷ 2),
  //           figé au moment du placement. Récompense la variété de l'armée.
  "trees": [
    {
      "id": "commandant",
      "nodes": [
        // ── Branche 0 : le COMMANDANT lui-même ──────────────────────────────────────────────────
        { "id": "cmd_Esquive",   "branch": 0, "level": 1, "effects": [ { "kind": "commanderTrait", "trait": "Esquive" } ] },
        { "id": "cmd_puissance", "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "damage", "amount": 2, "scale": "perDistinctPair" } ] },        
        { "id": "cmd_mouvement", "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "moveRange",   "amount": 1 } ] },
        { "id": "cmd_vie",       "branch": 0, "level": 3, "effects": [ { "kind": "commanderStat", "stat": "hp",     "amount": 2, "scale": "perDistinctPair" } ] },
        { "id": "cmd_Orage", "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Orage" } ] },
        { "id": "cmd_portee",    "branch": 0, "level": 4, "effects": [ { "kind": "commanderStat", "stat": "attackRange", "amount": 1 } ] },

        // ── Branche 1 : les TROUPES (tout le roster hors commandant) ────────────────────────────
        { "id": "troupe_vie",       "branch": 1, "level": 1, "effects": [ { "kind": "unitStat", "stat": "hp", "amount": 2 } ] },
        { "id": "troupe_releve",    "branch": 1, "level": 2, "effects": [ { "kind": "eliteDeathRecruit", "amount": 1 } ] },        
        { "id": "troupe_vie_paire", "branch": 1, "level": 2, "effects": [ { "kind": "unitStat", "stat": "hp",     "amount": 1, "scale": "perDistinctPair" } ] },
        { "id": "troupe_puissance", "branch": 1, "level": 3, "effects": [ { "kind": "unitStat", "stat": "damage", "amount": 1, "scale": "perDistinctPair" } ] },
        { "id": "troupe_mouvement", "branch": 1, "level": 4, "effects": [ { "kind": "unitStat", "stat": "moveRange", "amount": 1 } ] },

        // ── Branche 2 : la LOGISTIQUE (déploiement + réserve) ───────────────────────────────────
        { "id": "logi_deploiement_1", "branch": 2, "level": 1, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "logi_reserve_1",     "branch": 2, "level": 2, "effects": [ { "kind": "reserveSlots", "amount": 2 } ] },
        { "id": "troupe_fusion", "branch": 2, "level": 2, "effects": [ { "kind": "fusionRecruit",  "amount": 1 } ] },
        { "id": "logi_deploiement_2", "branch": 2, "level": 3, "effects": [ { "kind": "deploySlots", "amount": 2 } ] },
        // logi_deploiement_3 : REPURPOSÉ en « Grande Armée » (+4 réserve) — cf. strings.csv tree.logi_deploiement_3.
        { "id": "logi_deploiement_3", "branch": 2, "level": 3, "effects": [ { "kind": "reserveSlots", "amount": 4 } ] },
        // amalgame : la fusion ne demande plus que 2 pions (au lieu de 3). Icône : Assets/CommandTree/amalgame.png.
        { "id": "amalgame",           "branch": 2, "level": 4, "effects": [ { "kind": "fusionSizeReduction", "amount": 1 } ] }
      ]
    },

    // ── Arbre du commandant LANCIER (tree "commandantLancier") ─────────────────────────────────────────
    // Thème : le domaine de la TOUR (Lanciers) et les AURAS. Trois nouveaux effets par rapport à l'arbre de
    // base : "domaine" restreint un bonus d'unité au domaine ciblé (ici Tour) ; l'échelle "perDomaineUnit"
    // multiplie le bonus par le nombre d'unités de ce domaine (réserve + jeu) ; une recrue (fusion/relève)
    // avec "domaine" recrute la CLASSE DE BASE de ce domaine (un Lancier) au lieu d'un tier 1 vu au hasard.
    {
      "id": "commandantLancier",
      "nodes": [
        // ── Branche 0 : le COMMANDANT (Lancier) ─────────────────────────────────────────────────
        { "id": "lan_cmd_rempart",           "branch": 0, "level": 1, "effects": [ { "kind": "commanderTrait", "trait": "Rempart" } ] },
        { "id": "lan_cmd_portee",            "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "attackRange", "amount": 1 } ] },
        { "id": "lan_cmd_pv_tour",           "branch": 0, "level": 2, "effects": [ { "kind": "commanderStat", "stat": "hp", "amount": 3, "scale": "perDomaineUnit", "domaine": "Tour" } ] },
        { "id": "lan_cmd_aura_rempart",      "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Aura de rempart" } ] },
        { "id": "lan_cmd_riposte",           "branch": 0, "level": 3, "effects": [ { "kind": "commanderTrait", "trait": "Riposte" } ] },
        // Repurposé « Séisme » : à la fin du tour ennemi, le commandant frappe les ennemis adjacents pour sa puissance.
        { "id": "lan_cmd_seisme", "branch": 0, "level": 4, "effects": [ { "kind": "commanderTrait", "trait": "Séisme" } ] },

        // ── Branche 1 : les UNITÉS du domaine TOUR (Lanciers) ───────────────────────────────────
        { "id": "lan_tour_pv",             "branch": 1, "level": 1, "effects": [ { "kind": "unitStat", "stat": "hp", "amount": 4, "domaine": "Tour" } ] },
        // Repurposé « Rempart renforcé » : la réduction du trait Rempart passe de 4 à 6 (bonus +2).
        { "id": "lan_tour_pv_tour",        "branch": 1, "level": 3, "effects": [ { "kind": "rempartBonus", "amount": 2 } ] },
        { "id": "lan_tour_aura_puissance", "branch": 1, "level": 2, "effects": [ { "kind": "unitTrait", "trait": "Aura de puissance", "domaine": "Tour" } ] },
        { "id": "lan_tour_releve",         "branch": 1, "level": 2, "effects": [ { "kind": "eliteDeathRecruit", "amount": 1, "domaine": "Tour" } ] },
        // Repurposé « Formation renforcée » : la puissance par allié adjacent du trait Formation passe de 2 à 3 (bonus +1, joueur seulement).
        { "id": "lan_formation_renforce",  "branch": 1, "level": 3, "effects": [ { "kind": "formationBonus", "amount": 1 } ] },
        // « Marche des lanciers » descend ici (déplacement +1 aux unités Tour), à la place de l'allonge.
        { "id": "lan_tour_pm",             "branch": 1, "level": 4, "effects": [ { "kind": "unitStat", "stat": "moveRange", "amount": 1, "domaine": "Tour" } ] },

        // ── Branche 2 : la LOGISTIQUE (déploiement + réserve + fusion) ───────────────────────────
        { "id": "lan_logi_deploy_1", "branch": 2, "level": 1, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "lan_logi_fusion",   "branch": 2, "level": 2, "effects": [ { "kind": "fusionRecruit", "amount": 1, "domaine": "Tour" } ] },
        //{ "id": "lan_logi_deploy_2", "branch": 2, "level": 2, "effects": [ { "kind": "deploySlots",  "amount": 1 } ] },
        { "id": "lan_logi_reserve_1","branch": 2, "level": 2, "effects": [ { "kind": "reserveSlots", "amount": 2 } ] },
        { "id": "lan_logi_deploy_3", "branch": 2, "level": 3, "effects": [ { "kind": "deploySlots",  "amount": 2 } ] },
        // Repurposé « Amalgame » (Tour) : une fusion d'une classe du domaine de la TOUR ne demande que 2 pions.
        { "id": "lan_logi_reserve_2","branch": 2, "level": 4, "effects": [ { "kind": "fusionSizeReduction", "amount": 1, "domaine": "Tour" } ] }
      ]
    }
  ]
}
