  // Classes EXCLUSIVES : meme format qu'un domaine (base -> 2 branches -> 2 feuilles), mais HORS de tout
  // tirage et de toute fusion. Elles n'existent que par l'arbre de commandement qui les amene : aujourd'hui
  // le seul cas est le PAYSAN du commandant BRUTE, recrute par le noeud "brute_paysan" et fait evoluer par
  // les noeuds a choix "brute_armement" / "brute_protection" (cf. commander_trees.json). Le champ "domaine"
  // donne le motif de deplacement emprunte, comme pour un meneur.
  // Le Paysan est VOLONTAIREMENT miserable : toute sa valeur vient du trait "Survivant" (+1 puissance et
  // +2 pv max par mission jouee, cumules sur la run) et de ses evolutions d'arbre, qui n'ajoutent chacune
  // qu'une portee, un pas, ou un trait defensif.
  // ASSETS : Assets/Units/<asset>_{front,back}.png (64x64) pour chacune des 7 classes. Les variantes
  // "_ia_" sont INUTILES ici (ce pion n'apparait jamais dans un camp ennemi). Les 4 FEUILLES (tier 3) ont EN
  // PLUS une version MENEUSE, affichee des que le noeud "Revolte" est achete :
  // <asset>_chef_{front,back}.png. Les formes intermediaires n'en ont pas : promues sans etre arrivees au
  // bout de leur arbre, elles gardent leur sprite ordinaire (repli du rendu).
  "exclusives": [
    {
      "domaine": "Dame",
      "baseClass": {
        "name": "Paysanne", "asset": "paysan", "hp": 8, "damage": 4, "moveRange": 1, "attackRange": 1, "traits": ["Survivant"],
        "evolutions": [
          {
            "name": "Paysanne archère", "asset": "paysan_archer", "hp": 8, "damage": 4, "moveRange": 1, "attackRange": 2, "traits": ["Survivant"],
            "evolutions": [
              { "name": "Paysanne archère duelliste", "asset": "paysan_archer_duelliste", "hp": 8, "damage": 4, "moveRange": 2, "attackRange": 2, "traits": ["Survivant", "Duelliste"] },
              { "name": "Paysanne archère rempart",   "asset": "paysan_archer_rempart",   "hp": 18, "damage": 4, "moveRange": 1, "attackRange": 2, "traits": ["Survivant", "Rempart"] }
            ]
          },
          {
            "name": "Paysanne épéiste", "asset": "paysan_epeiste", "hp": 8, "damage": 4, "moveRange": 2, "attackRange": 1, "traits": ["Survivant"],
