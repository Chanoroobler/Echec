  // Unités COMMANDE (meneurs). COMMANDE est un ROLE, pas un domaine : chaque meneur emprunte le motif
  // de déplacement d'un des domaines (champ "domaine"). role = "Commander" (joueur) ou "Boss" (ennemi).
  // Un boss peut aussi porter de l'EQUIPEMENT : "equipmentPool" (ids d'equipment.json, ecrits a la main) au
  // niveau du boss + "equipmentCount" par phase = combien il en tire, sans doublon. Cf. le boss Marchand.
  //
  // BOSS : un boss = une IDENTITE (name + asset/sprite + domaine de déplacement) et un PROFIL PAR PHASE dans
  // "phases" ("1".."3" -> stats + traits). Un boss n'est eligible qu'aux phases qu'il declare. A chaque run,
  // le jeu tire 3 boss DISTINCTS (un par phase, deterministe via la graine) et chacun combat avec le profil
  // de SA phase. Il faut au moins 3 boss definis (avec leurs sprites) pour ne jamais repeter un boss ; avec
  // moins, la repetition est autorisee. Champs d'un profil : hp, damage, moveRange, attackRange, et en option
  // minAttackRange (X a Y), piercesAllies, attackDomaine, traits (liste, cf. traits de units.json).
  //
  // Un COMMANDANT porte en plus ses plafonds d'armée (deployments = pions posables COMMANDANT COMPRIS,
  // reserveSize = pions en réserve HORS commandant), l'id de son arbre de commandement (tree →
  // commander_trees.json) et sa source de points PROPRE : soit fusionPoints (points gagnés à chaque fusion),
  // soit onHitPoints (points gagnés à chaque coup REÇU par le commandant, plafonné à onHitCap coups par combat).
  "commandes": [
    { "role": "Commander", "id": "commandant", "domaine": "Dame", "name": "Commandant", "asset": "commandant", "hp": 28, "damage": 12, "moveRange": 1, "attackRange": 1,
      "deployments": 5, "reserveSize": 8, "tree": "commandant", "fusionPoints": 2,
      "startingUnits": [ "Tour", "Dame" ] },
    // PROVISOIRE : deuxieme commandant, la pour eprouver le carrousel de selection. Il reprend le sprite du
    // boss Commandant_brute (les boss deviendront des commandants par la suite) et l'arbre du premier.
    // Brute : plus resistant et plus fort, mais il se deplace moins loin, deploie moins de pions, et il
    // commence avec TROIS pions plus varies au lieu de deux Soldats.
    // "unlocked": false => VERROUILLE : silhouette noire dans le carrousel, partie impossible a lancer.
    // La condition de deblocage reste a definir ; en attendant, basculer ce champ suffit a l'ouvrir.
    {
      "role": "Commander",
      "id": "Commandant_lancier",
      "domaine": "Tour",
      "name": "Lancier",
      "asset": "Commandant_lancier",
      "hp": 40,
      "damage": 10,
      "moveRange": 2,
      "attackRange": 2,
      "deployments": 5,
      "reserveSize": 8,
      "tree": "commandantLancier",
      "fusionPoints": 0,
      "onHitPoints": 1,
      "onHitCap": 1,
      "startingUnits": [ "Tour", "Tour" ],
      "unlocked": false
    },
    // Commandant du domaine du FOU (mage). Se deplace en diagonale (domaine Fou), thème magie/soutien :
    // portee, soins, drain, tempete, et les auras/liens de son domaine (arbre "commandantFou"). Fragile mais
    // a longue portee. Source de points PROPRE : "sur coup a distance" (rangedHitPoints) = +1 point quand le
    // commandant TOUCHE un ennemi a portee 3 ou plus (max 2 par combat). VERROUILLE : debloque en battant en
    // derniere phase le boss "Commandant_fou" (unlocksCommander). STATS PROVISOIRES, a equilibrer.
    {
      "role": "Commander",
      "id": "Commandant_fou",
      "domaine": "Fou",
      "name": "Mage",
      "asset": "Commandant_fou",
      "hp": 20,
      "damage": 16,
      "moveRange": 2,
      "attackRange": 3,
      "deployments": 5,
      "reserveSize": 8,
      "tree": "commandantFou",
      "rangedHitPoints": 1,
      "rangedHitCap": 2,
      "startingUnits": [ "Fou", "Fou" ],
      "unlocked": false
    },
    // Commandant du domaine du CAVALIER. Se deplace en L (saut), thème charge/isolement : il porte
    // « Franchissement » NATIVEMENT (comme la classe Cavalier) et son arbre "commandantCavalier" tourne autour
    // de l'Impact, du Vol, du Loup solitaire et des Épines. Source de points PROPRE : « sur saut » (jumpPoints)
    // = +1 point chaque fois qu'il saute PAR-DESSUS une unite ou un obstacle de terrain (max 2 par combat).
    // VERROUILLE : debloque en battant en derniere phase le boss "Commandant_cavalier" (unlocksCommander).
    // STATS PROVISOIRES, a equilibrer.
    {
      "role": "Commander",
      "id": "Commandant_cavalier",
      "domaine": "Cavalier",
      "name": "Chevalier",
      "asset": "Commandant_cavalier",
      "hp": 32,
      "damage": 12,
      "moveRange": 3,
      "attackRange": 3,
      "deployments": 4,
      "reserveSize": 8,
      "tree": "commandantCavalier",
      "traits": [ "Franchissement" ],
      "jumpPoints": 1,
      "jumpCap": 2,
      "startingUnits": [ "Cavalier", "Cavalier" ],
      "unlocked": false
    },
    // Commandant MARCHAND. Se deplace en L (domaine Cavalier) : un convoyeur qui traverse le plateau pour
    // ramasser le butin. Theme : l'EQUIPEMENT — son arbre "commandantMarchand" lui donne des slots (il est le
    // SEUL commandant qui s'equipe), double les butins de coffre, ameliore les raretes et transforme la
    // logistique. Source de points PROPRE : « sur butin » (lootPoints) = +1 point par coffre OUVERT ou tuile
    // RECRUE ramassee, max lootCap = 3 par combat (les deux sources partagent le meme plafond). En echange il
    // ne touche qu'UN point par mission reussie (missionPoints:1) la ou les autres en touchent 2 : son revenu
    // se gagne sur le terrain, pas a l'arrivee.
    // VERROUILLE : se debloque a la fin d'une partie quand le joueur a ouvert 30 coffres AU TOTAL (compteur du
    // profil, cf. SaveService.ChestUnlockThreshold) — pas de boss lie.
    // ASSET A DESSINER : Assets/Units/Commandant_marchand_{front,back,ia_front,ia_back}.png (64x64).
    // STATS PROVISOIRES, a equilibrer.
    {
      "role": "Commander",
