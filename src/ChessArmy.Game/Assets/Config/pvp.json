  // Économie des coffres. Les points de départ ouvrent un coffre de chaque type (tuto multi).
  "chestCost": { "units": 60, "equipment": 40 },
  "startPoints": 100,
  "pointsPerKill": 5,
  "pointsForWin": 30,
  "pointsForDraw": 5,

  // Temps (secondes).
  "reserveSeconds": 600,
  "moveSeconds": 60,
  "reconnectSeconds": 60,
  // Réserve sous laquelle chaque tour joué fait tomber une tuile des 2 lignes derrière le joueur.
  "collapseBelowSeconds": 240,
  "buildChoiceSeconds": 30,
  // Recherche classée : personne au bout de « botAfterSeconds » → bot du niveau du joueur (partie classée).
  "botAfterSeconds": 10,

  // Cote (Elo) et rangs. Un rang couvre la cote de « from » jusqu'au rang suivant, découpé en « divisions »
  // tranches égales (la division III est la plus basse). Master n'a pas de division.
