    "equilibre": { "names": [ "Aldric", "Fiora", "Kilian", "Perrine" ] },
    "agressif":  { "advance": 1.25, "aggression": 1.6, "names": [ "Bérénice", "Gaspard", "Mathis", "Octave" ] },
