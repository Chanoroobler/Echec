  // Économie des coffres. Les points de départ ouvrent un coffre de chaque type (tuto multi).
  "chestCost": { "units": 60, "equipment": 40 },
  "startPoints": 100,
  "pointsPerKill": 5,
  "pointsForWin": 30,
  "pointsForDraw": 5,
  // Part des points selon le mode (la cote ne bouge qu'en partie classée) :
  // entraînement contre un bot de rang choisi = moitié, défi entre amis = rien.
  "trainingPointsFactor": 0.5,
  "friendlyPointsFactor": 0,

  // Temps (secondes).
  "reserveSeconds": 600,
  "moveSeconds": 120,
  "reconnectSeconds": 60,
  // Réserve sous laquelle chaque tour joué fait tomber une tuile des 2 lignes derrière le joueur.
  "collapseBelowSeconds": 240,
  "buildChoiceSeconds": 30,
  // Après le pile ou face : temps pour étudier l'armée adverse (pendules gelées), fini plus tôt si les deux sont prêts.
  "analysisSeconds": 60,
  // Balance du MORAL : chaque pion tombé (commandant exclu) la fait pencher de son prix (« unitCost ») vers
  // l'adversaire. Balance à ±moraleToWin = victoire du camp vers qui elle penche. 0 = désactivé.
  "moraleToWin": 15,
  // Camp réduit à son commandant (Basile compris) : à chaque fin de SON tour, la balance penche d'autant vers
  // l'adversaire. Le roi isolé ne peut plus fuir sans fin.
  "loneCommanderMorale": 1,
  // Recherche classée : personne au bout de « botAfterSeconds » → bot du niveau du joueur (partie classée).
  // S'il y a d'AUTRES joueurs sur le jeu (compte Steam des joueurs en jeu, ou un lobby multi visible), on attend
  // « botAfterBusySeconds » à la place : un humain a des chances d'arriver.
  "botAfterSeconds": 10,
  "botAfterBusySeconds": 40,

  // Cote (Elo) et rangs. Un rang couvre la cote de « from » jusqu'au rang suivant, découpé en « divisions »
  // tranches égales (la division III est la plus basse). Master n'a pas de division.
  "startRating": 950,
  "eloK": 50,
  // Plafond de la cote (bonus de série compris).
  "maxRating": 3000,
  // Série de victoires classées : à partir de la « winStreakFrom »e victoire d'affilée, +« winStreakBonus » de cote.
  "winStreakFrom": 3,
  "winStreakBonus": 15,
  "ranks": [
    { "id": "bronze", "from": 0, "divisions": 3, "span": 300 },
    { "id": "fer", "from": 1100, "divisions": 3, "span": 300 },
    { "id": "argent", "from": 1400, "divisions": 3, "span": 300 },
    { "id": "or", "from": 1700, "divisions": 3, "span": 300 },
    { "id": "master", "from": 2000, "divisions": 1, "span": 0 }
  ],

