  // Bots de secours : un niveau d'IA PAR DIVISION (bronze-3 le plus faible … master), pour sentir la montée.
  // Armées : « botArmies » pour tous, sauf Bronze et Fer (« beginnerArmies » : la réserve « botArmiesBeginner »,
  // pions de base). À part ça, seule l'INTELLIGENCE monte.
  //   forceAttack : attaque dès qu'un pion le peut (plancher : jamais complètement bête) ;
  //   killChance  : avec forceAttack, chance de choisir la meilleure attaque (tuer) plutôt qu'une au hasard ;
  //   caution     : 0 = fonce sans regarder le danger, 1 = pèse l'échange ;
  //   recklessness: part des coups où il fonce sans regarder le danger (pente douce des rangs bas) ;
  //   depth       : 0 = un coup à la fois, 1 = prévoit la réponse adverse, 2 = et sa propre réponse… ;
  //   breadth / replyBreadth : coups examinés à la racine / plus bas ;
  //   accuracy    : chance de jouer son meilleur coup (sinon un des deux suivants) ;
  //   equipment   : false = armées SANS équipement (Bronze, Fer) ; à partir d'Argent, équipements tirés au hasard
  //                 à chaque partie, 10 pts (la même armée ne revient pas toujours pareille).
  //   minDelaySeconds / maxDelaySeconds : « réflexion » affichée avant chaque coup, tirée au hasard (air d'un joueur) ;
  //   le vrai calcul se fait pendant ce temps, et le rang le plus haut joue plus vite.
  // Échelle MESURÉE par l'outil (--ai-ladder) : chaque niveau doit battre le précédent.
  "bots": {
    "bronze-3": { "beginnerArmies": true, "equipment": false, "forceAttack": true, "killChance": 0.25, "caution": 0.3, "recklessness": 1.0, "accuracy": 0.45, "minDelaySeconds": 3, "maxDelaySeconds": 8 },
    "bronze-2": { "beginnerArmies": true, "equipment": false, "forceAttack": true, "killChance": 0.45, "caution": 0.35, "recklessness": 0.7, "accuracy": 0.55, "minDelaySeconds": 3, "maxDelaySeconds": 8 },
    "bronze-1": { "beginnerArmies": true, "equipment": false, "forceAttack": true, "killChance": 0.55, "caution": 0.4, "recklessness": 0.5, "accuracy": 0.65, "minDelaySeconds": 3, "maxDelaySeconds": 7.5 },
    "fer-3":    { "beginnerArmies": true, "equipment": false, "forceAttack": true, "killChance": 0.7, "caution": 0.5, "recklessness": 0.3, "accuracy": 0.75, "minDelaySeconds": 3, "maxDelaySeconds": 7.5 },
    "fer-2":    { "beginnerArmies": true, "equipment": false, "forceAttack": true, "killChance": 0.85, "caution": 0.7, "recklessness": 0.15, "accuracy": 0.85, "minDelaySeconds": 3, "maxDelaySeconds": 7 },
    "fer-1":    { "beginnerArmies": true, "equipment": false, "forceAttack": true, "killChance": 0.95, "caution": 1.0, "accuracy": 0.95, "minDelaySeconds": 2.5, "maxDelaySeconds": 7 },
    "argent-3": { "depth": 1, "breadth": 4, "replyBreadth": 3, "accuracy": 0.8, "minDelaySeconds": 2.5, "maxDelaySeconds": 6.5 },
